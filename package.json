{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.120.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "name": "liquidLsp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/client.js",
  "type": "module",
  "publisher": "liquid",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:liquid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "liquid",
        "aliases": [
          "Liquid"
        ],
        "extensions": [
          ".liquid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "liquid",
        "scopeName": "text.html.liquid",
        "path": "./syntaxes/liquid.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "tsx": "tsx",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --test --import tsx src/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastest-levenshtein": "^1.0.16",
    "liquidjs": "^10.27.0",
    "vscode-languageclient": "^10.0.0",
    "vscode-languageserver": "^10.0.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
