{
  "name": "liquid-vscode-extension",
  "version": "1.0.0",
  "publisher": "liquid",
  "main": "dist/client.js",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:liquid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "liquid",
        "aliases": [
          "Liquid"
        ],
        "extensions": [
          ".liquid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "liquid",
        "scopeName": "text.html.liquid",
        "path": "./syntaxes/liquid.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Liquid Language Server",
      "properties": {
        "liquid.schema": {
          "type": "object",
          "default": {
            "my_string_var": "string",
            "my_number_var": "number",
            "my_boolean_var": "boolean",
            "my_date_var": "date",
            "my_currency_var": "currency",
            "my_dropdown_var": {
              "type": "dropdown",
              "options": [
                "Draft",
                "Active",
                "Inactive"
              ]
            },
            "my_composite_var": {
              "type": "composite",
              "fields": {
                "id": "number",
                "name": "string",
                "price": "currency",
                "status": {
                  "type": "dropdown",
                  "options": [
                    "A",
                    "B"
                  ]
                }
              }
            }
          },
          "description": "Predefined variable schemas and types. Supported types: 'string', 'number', 'boolean', 'date', 'currency', dropdown object type, and composite nested object types."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && node build.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3"
  }
}
