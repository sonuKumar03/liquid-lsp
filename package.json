{
  "name": "liquid-lsp-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "package:extension": "pnpm build && pnpm --filter liquid-lsp-vscode-extension package:vsix",
    "build:playground": "pnpm --filter liquid-lsp-express-server build",
    "start:playground": "pnpm --filter liquid-lsp-express-server start",
    "dev:playground": "pnpm --filter liquid-lsp-express-server dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "pnpm": "^10.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "liquidjs": "github:sonuKumar03/liquidjs"
  }
}
