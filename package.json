{
  "name": "liquid-lsp-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "lsp-engine",
    "vscode-extension",
    "express-server",
    "liquidjs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
