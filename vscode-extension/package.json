{
  "name": "liquid-lsp-vscode-extension",
  "version": "1.0.0",
  "publisher": "liquid",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonuKumar03/liquid-lsp.git"
  },
  "main": "dist/client.cjs",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:liquid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "liquid",
        "aliases": [
          "Liquid"
        ],
        "extensions": [
          ".liquid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "liquid",
        "scopeName": "text.html.liquid",
        "path": "./syntaxes/liquid.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Liquid Language Server",
      "properties": {
        "liquid.schema": {
          "type": "object",
          "default": {
            "my_string_var": "string",
            "my_number_var": "number",
            "my_boolean_var": "boolean",
            "my_date_var": "date",
            "my_currency_var": "currency",
            "my_dropdown_var": {
              "type": "dropdown",
              "options": [
                "Draft",
                "Active",
                "Inactive"
              ]
            },
            "my_composite_var": {
              "type": "composite",
              "fields": {
                "id": "number",
                "name": "string",
                "price": "currency",
                "status": {
                  "type": "dropdown",
                  "options": [
                    "A",
                    "B"
                  ]
                }
              }
            }
          },
          "description": "Predefined variable schemas and types. Supported types: 'string', 'number', 'boolean', 'date', 'currency', dropdown object type, and composite nested object types."
        },
        "liquid.server.mode": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "default": "local",
          "description": "Select whether to run the server locally ('local') or connect to a remote deployed server ('remote')."
        },
        "liquid.server.host": {
          "type": "string",
          "default": "localhost",
          "description": "The host address of the remote deployed LSP server (only applicable if mode is 'remote')."
        },
        "liquid.server.port": {
          "type": "integer",
          "default": 6009,
          "description": "The port number of the remote deployed LSP server (only applicable if mode is 'remote')."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && node build.js",
    "package": "npm run build && npm run package:vsix",
    "package:vsix": "vsce package --no-dependencies --out dist/liquid-lsp.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.3",
    "typescript": "^6.0.3"
  }
}
